class Player(arcade.Sprite):
    def __init__(self):
        super().__init__()

        # Устанавливаем стандартные размеры
        self.width = 40
        self.height = 50
        self.center_x = 100
        self.center_y = 200

        # Используем цвет из TEXTURES
        player_color = TEXTURES.get('player_idle', arcade.color.BLUE)
        self.color = player_color

        self.speed, self.jump_speed = PLAYER_SPEED, PLAYER_JUMP_SPEED
        self.velocity_y = self.change_x = 0
        self.on_ground = self.on_wall = False
        self.health, self.max_health = 3, 3
        self.invincible_timer = 0
        self.direction = 1
        self.walk_timer = 0
        self.walk_animation = False

        # Новый атрибут для коробки, которую несем
        self.carrying_box = None
        self.carrying_offset_y = 40

    def update(self):
        self.velocity_y -= GRAVITY
        if self.velocity_y < -20:
            self.velocity_y = -20
        self.center_y += self.velocity_y
        self.center_x += self.change_x

        # Простая анимация мигания при движении
        if abs(self.change_x) > 0 and self.on_ground:
            self.walk_timer += 1
            if self.walk_timer >= 8:
                self.walk_timer = 0
                self.walk_animation = not self.walk_animation
                # Меняем цвет при ходьбе
                if self.walk_animation:
                    self.color = arcade.color.LIGHT_BLUE
                else:
                    self.color = TEXTURES.get('player_idle', arcade.color.BLUE)
        elif self.on_ground:
            self.color = TEXTURES.get('player_idle', arcade.color.BLUE)
        elif self.velocity_y > 0:
            self.color = arcade.color.SKY_BLUE

        # Если несем коробку, меняем цвет для индикации
        if self.carrying_box:
            self.color = arcade.color.CYAN

        if self.invincible_timer > 0:
            self.invincible_timer -= 1
            self.alpha = 150 if random.random() > 0.5 else 255
        else:
            self.alpha = 255

    def jump(self):
        if self.on_ground:
            self.velocity_y = self.jump_speed
            self.on_ground = False
            return True
        return False

    def wall_jump(self, direction):
        if self.on_wall:
            self.velocity_y = self.jump_speed * 0.9
            self.change_x = direction * self.speed * 1.5
            return True
        return False

    def take_damage(self):
        if self.invincible_timer <= 0:
            self.health -= 1
            self.invincible_timer = 60
            self.color = arcade.color.RED
            return True
        return False


