class Enemy(arcade.Sprite):
    def __init__(self, x, y, patrol_range=150):
        # Создаем цветного врага
        super().__init__()

        # Устанавливаем стандартные размеры
        self.width = 40
        self.height = 40
        self.center_x = x
        self.center_y = y + 20

        enemy_color = TEXTURES.get('enemy', arcade.color.PURPLE)
        self.color = enemy_color

        self.speed, self.direction = 1.5, 1
        self.start_x = x
        self.patrol_range = patrol_range
        self.animation_timer = 0
        self.normal_color = enemy_color
        self.alt_color = TEXTURES.get('enemy_move', arcade.color.DARK_VIOLET)

    def update(self):
        self.center_x += self.speed * self.direction

        # Анимация врага (мигание)
        self.animation_timer += 1
        if self.animation_timer >= 30:
            self.animation_timer = 0
            if self.color == self.normal_color:
                self.color = self.alt_color
            else:
                self.color = self.normal_color

        if abs(self.center_x - self.start_x) > self.patrol_range:
            self.direction *= -1


