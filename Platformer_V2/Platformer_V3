    texture_colors = {
        'player_idle': arcade.color.BLUE,
        'player_walk': arcade.color.BLUE,
        'player_jump': arcade.color.BLUE,

        'grass_mid': arcade.color.GREEN,
        'grass_left': arcade.color.DARK_GREEN,
        'grass_right': arcade.color.DARK_GREEN,
        'grass_center': arcade.color.FOREST_GREEN,
        'stone_mid': arcade.color.GRAY,
        'dirt_mid': arcade.color.BROWN,
        'brick': arcade.color.BROWN,

        'box': arcade.color.SIENNA,
        'button_red': arcade.color.RED,
        'button_green': arcade.color.LIME_GREEN,
        'door_closed': arcade.color.DARK_BROWN,
        'door_open': arcade.color.LIGHT_BROWN,
        'enemy': arcade.color.PURPLE,
        'enemy_move': arcade.color.DARK_VIOLET,
        'spikes': arcade.color.DARK_RED,
        'heart': arcade.color.RED,
        'heart_grey': (100, 100, 100),

        'bush': arcade.color.FOREST_GREEN,
        'tree': arcade.color.DARK_GREEN,
        'cloud': arcade.color.WHITE,
        'rock': arcade.color.DARK_GRAY,
        'lava': arcade.color.RED_ORANGE,
    }

    for name, color in texture_colors.items():
        textures[name] = color

    return textures


