        self.level = level

        # Списки спрайтов
        self.player_list = None
        self.platform_list = None
        self.box_list = None
        self.button_list = None
        self.door_list = None
        self.enemy_list = None
        self.spike_list = None
        self.heart_list = None
        self.decoration_list = None

        self.player = None
        self.left_pressed = self.right_pressed = self.up_pressed = False

        self.camera = arcade.camera.Camera2D()
        self.gui_camera = arcade.camera.Camera2D()

        self.game_over = False
        self.level_complete = False

        # Таймер для отображения сообщения об открытой двери
        self.door_opened_message_timer = 0

        # Флаги для проигрывания звуков
        self.game_over_sound_played = False
        self.level_complete_sound_played = False

        # Загружаем звуки
        self.load_sounds()

        self.setup()

    def load_sounds(self):
        # Создаем более заметные звуки с разной частотой
        try:
            # Звук поражения - низкий и длинный
            self.game_over_sound = arcade.Sound(":resources:sounds/hit5.wav")

            # Звук победы - высокий и радостный
            self.level_complete_sound = arcade.Sound(":resources:sounds/coin5.wav")

            # Звук получения урона
            self.damage_sound = arcade.Sound(":resources:sounds/hurt5.wav")

            # Звук прыжка
            self.jump_sound = arcade.Sound(":resources:sounds/jump3.wav")

            # Звук взятия/броска коробки
            self.box_sound = arcade.Sound(":resources:sounds/rockHit2.wav")

            # Звук нажатия кнопки
            self.button_sound = arcade.Sound(":resources:sounds/upgrade4.wav")

            # Звук открытия двери
            self.door_sound = arcade.Sound(":resources:sounds/secret4.wav")

        except Exception as e:
            print(f"Не удалось загрузить стандартные звуки: {e}")

            # Создаем простые звуки вручную если не получилось загрузить
            try:
                # Звук поражения
                self.game_over_sound = self.create_beep_sound(200, 1000)
                # Звук победы
                self.level_complete_sound = self.create_beep_sound(800, 500)
                # Звук получения урона
                self.damage_sound = self.create_beep_sound(400, 200)
                # Звук прыжка
                self.jump_sound = self.create_beep_sound(600, 150)
                # Звук взятия/броска коробки
                self.box_sound = self.create_beep_sound(300, 100)
                # Звук нажатия кнопки
                self.button_sound = self.create_beep_sound(500, 300)
                # Звук открытия двери
                self.door_sound = self.create_beep_sound(700, 400)
            except:
                self.game_over_sound = None
                self.level_complete_sound = None
                self.damage_sound = None
                self.jump_sound = None
                self.box_sound = None
                self.button_sound = None
                self.door_sound = None

    def create_beep_sound(self, frequency=440, duration_ms=100):
        # Создаем короткий звуковой сигнал
        sample_rate = 44100
        duration = duration_ms / 1000.0  # в секундах
        num_samples = int(sample_rate * duration)

        # Создаем массив сэмплов
        import numpy as np
        t = np.linspace(0, duration, num_samples, False)

        # Синусоидальная волна
        wave = np.sin(frequency * 2 * np.pi * t)

        # Амплитудная огибающая для плавного начала и конца
        envelope = np.ones_like(wave)
        attack_len = int(0.05 * sample_rate)  # 50ms атака
        release_len = int(0.1 * sample_rate)  # 100ms релиз

        for i in range(attack_len):
            envelope[i] = i / attack_len

        for i in range(release_len):
            envelope[-i - 1] = i / release_len

        wave = wave * envelope

        # Конвертируем в байты
        wave = (wave * 32767).astype(np.int16).tobytes()

        # Создаем звук
        sound = arcade.Sound(wave, streaming=False)
        return sound

    def setup(self):
        # Инициализируем списки спрайтов
        self.player_list = arcade.SpriteList()
        self.platform_list = arcade.SpriteList()
        self.box_list = arcade.SpriteList()
        self.button_list = arcade.SpriteList()
        self.door_list = arcade.SpriteList()
        self.enemy_list = arcade.SpriteList()
        self.spike_list = arcade.SpriteList()
        self.heart_list = arcade.SpriteList()
        self.decoration_list = arcade.SpriteList()

